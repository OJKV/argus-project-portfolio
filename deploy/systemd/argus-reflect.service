[Unit]
Description=ARGUS weekly reflection
After=network-online.target
# A failure (non-zero exit, or killed at TimeoutStartSec) alerts on Telegram instead of
# living only in journald (J-N12). See argus-failure@.service.
OnFailure=argus-failure@%n.service
[Service]
Type=oneshot
User=argus
# Hardening (P-5): only directives that cannot break this service. Not ProtectHome (the venv's
# Python is uv's, under /home/argus), not MemoryDenyWriteExecute (numba JITs), and no capability
# keys (the root-owned installer refuses them; a non-root user with NoNewPrivileges has none).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
UMask=0027
WorkingDirectory=/opt/argus-project
# No EnvironmentFile (P-5): argus reads .env itself through Settings, from
# WorkingDirectory; exporting it put every secret into this process's environment.
# Holds deploy.lock SHARED while it runs (flock -s). This job takes no run lock, so nothing else
# keeps a deploy from swapping the code and the .venv under it; deploy/update.sh takes deploy.lock
# EXCLUSIVELY, so it waits for this job, and this job waits (up to 600 s, which TimeoutStartSec
# covers) for a swap. Same form as argus-live-keys.service uses for run.lock.
ExecStart=/usr/bin/flock -s -w 600 /var/lib/argus/deploy.lock /opt/argus-project/.venv/bin/argus reflect
# Reads the journal, makes one model call, appends to `lessons`. It places nothing, cancels
# nothing and reads no market data, so it is safe to run unattended — and it exits early without
# calling anything while fewer than three trades have closed.
#
# No healthcheck ping: HEALTHCHECKS_URL is the watchdog's heartbeat and pinging it from here
# would report the watchdog alive when it might not be. A missed reflection costs a week of
# learning, not a trade, which is why the Reflector is `optional` criticality.
TimeoutStartSec=1500
Nice=10

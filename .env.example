# ARGUS environment — copy to .env (chmod 600) and fill. NEVER commit .env.
# Names must match argus/config.py Settings fields (case-insensitive).
# NOTE: dotenv does NOT strip trailing "# comments" — keep comments on their own line.

# ── Mode & interlocks ────────────────────────────────────────────────────────
# MODE: demo | auto | approve. LIVE_TRADING must be exactly I_UNDERSTAND for auto|approve.
# NOTE: MODE=approve has NO approval step yet: it places orders exactly like MODE=auto. Nothing
# waits for a yes from you (review 2026-10-07, P-N2). Treat approve as auto until that changes.
MODE=demo
LIVE_TRADING=
# Real money only: with OKX_DEMO=false an armed MODE is refused unless this is exactly
# I_UNDERSTAND_REAL_MONEY. Leave it empty while trading the demo account.
LIVE_VENUE=
# RISK_PROFILE: empty = aggressive below $500, conservative once equity holds >= $500 for 7 days | conservative | aggressive
RISK_PROFILE=
# ARGUS_HOME holds journal.db + the HALT file. Use ./var locally, /var/lib/argus on the VPS.
ARGUS_HOME=./var
TZ_DISPLAY=Asia/Almaty

# ── Exchange ─────────────────────────────────────────────────────────────────
# OKX_HOST must stay www.okx.com: my./app./eea.okx.com serve PUBLIC data only and
# reject every API key with 401 code=50119. Authenticated calls need the VPN on from KZ.
OKX_HOST=https://www.okx.com
# Public market data may use an edge that works without the VPN from KZ (app./my./eea.okx.com).
# It serves identical public data and is never used for authenticated calls.
OKX_PUBLIC_HOST_OVERRIDE=https://app.okx.com
# OKX_DEMO=true → demo credentials + ccxt set_sandbox_mode(True) / x-simulated-trading.
OKX_DEMO=true
# OKX key allowlists are IPv4-only; a dual-stack server prefers IPv6 and would be rejected.
FORCE_IPV4=true
# Demo trading key (Trade → Demo Trading → API). Used whenever OKX_DEMO=true.
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=
# Live key — trade permission only, never withdrawal; IP-bind it to the VPS.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
BYBIT_KZ_HOST=https://api.bybit.kz
BYBIT_KZ_API_KEY=
BYBIT_KZ_API_SECRET=

# ── LLM providers (free tiers first; DeepSeek then OpenAI are the paid last resort) ──
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ZHIPU_API_KEY=
SAMBANOVA_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Paid LLM caps, USD per UTC month (owner 2026-10-26): $5 per provider, $10 overall. A paid
# provider missing from the JSON map has a cap of zero. The ceiling must be at least the sum
# of the caps or it, not the provider caps, decides. An old line of 5.0 here halves the budget.
PAID_MONTHLY_CAP_USD_BY_PROVIDER={"deepseek": 5.0, "openai": 5.0}
PAID_LLM_MONTHLY_CAP_USD=10.0

# ── Data sources ─────────────────────────────────────────────────────────────
COINALYZE_API_KEY=
COINGECKO_DEMO_API_KEY=
CMC_API_KEY=
# CryptoPanic: optional — the free Developer plan was reportedly discontinued in 2026.
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_API_KEY_2=
FRED_API_KEY=
ETHERSCAN_API_KEY=
DUNE_API_KEY=
SCIRA_API_KEY=
# EDGAR_USER_AGENT: "Name email@example.com" — the SEC requires a contact string.
EDGAR_USER_AGENT=

# ── Notify & observability ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOGFIRE_TOKEN=
HEALTHCHECKS_URL=
